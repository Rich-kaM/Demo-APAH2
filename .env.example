# Development defaults. Copy to .env and source it using your shell, or export values in your process manager.
NODE_ENV=development
HOST=127.0.0.1
PORT=4173
MAINTENANCE_MODE=false
PUBLIC_SITE_URL=

# Admin is disabled until set. ADMIN_PASSWORD_HASH format: salt:64-byte-scrypt-hex.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_ROLE=admin
ADMIN_LINK_SECRET=
# Production admin endpoints stay hidden unless a reverse-proxy/network ACL restricts them.
ADMIN_ACCESS_MODE=

# Contact / recruitment legal controls. Production form endpoints fail closed until the company sets these.
PRIVACY_CONTACT_EMAIL=
INQUIRY_NOTIFICATION_EMAIL=
CONTACT_RETENTION_DAYS=
APPLICATION_RETENTION_DAYS=
NEWSLETTER_RETENTION_DAYS=
LEGAL_NOTICE_REVIEW_APPROVED=false
RECRUITMENT_NOTICE_APPROVED=false
NEWSLETTER_CONSENT_APPROVED=false

# Production mail adapter settings (HTTPS webhook with JSON {from,to,subject,text,html}).
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=
EMAIL_FROM=
OUTBOUND_EMAIL_DAILY_LIMIT=
NEWSLETTER_SIGNUP_DISABLED=false

# Google reCAPTCHA v2 checkbox. These are configuration fields, not keys; keep actual secrets in a secret manager.
RECAPTCHA_MODE=test
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Production upload scanning. Use a trusted absolute executable path with no user-controlled shell arguments.
FILE_SCAN_COMMAND=
